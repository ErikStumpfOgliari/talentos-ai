generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum MembershipRole {
  OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum CandidateSource {
  LINKEDIN
  REFERRAL
  INBOUND
  INDEED
  TALENT_POOL
  CAREERS_PAGE
  MANUAL
  OTHER
}

enum ParserStatus {
  UPLOADED
  QUEUED
  PARSING
  PARSED
  NEEDS_REVIEW
  FAILED
}

enum PipelineCategory {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

enum NoteVisibility {
  INTERNAL
  TEAM
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  HIRING_MANAGER
  ONSITE
  FINAL
}

enum CalendarSyncStatus {
  NOT_SYNCED
  SYNCED
  CANCELLED
  FAILED
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum EmailTrigger {
  MANUAL
  APPLICATION_RECEIVED
  MOVED_TO_STAGE
  INTERVIEW_SCHEDULED
  OFFER_CREATED
  REJECTION_SENT
}

enum AutomationTrigger {
  STAGE_CHANGED
  INTERVIEW_SCHEDULED
  CANDIDATE_CREATED
  SCORE_UPDATED
  REJECTION_SENT
}

enum EmbeddingEntity {
  CANDIDATE_RESUME
  JOB_DESCRIPTION
}

enum AiAnalysisStatus {
  NOT_ANALYZED
  PROCESSING
  SUCCESS
  FAILED
}

enum AuthFactorMethod {
  EMAIL_CODE
  SMS_CODE
  AUTHENTICATOR_APP
}

enum AuthVerificationPurpose {
  LOGIN
  SIGNUP
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(PRO)
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Billing / subscription lifecycle.
  // `plan` = plano com acesso liberado hoje (durante o trial = PRO/Intermediário).
  // `selectedPlan` = plano que o cliente escolheu pagar ao fim do trial.
  billingStatus         BillingStatus @default(TRIALING)
  selectedPlan          Plan?
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  lastPaymentStatus     String?
  pagbankCustomerId     String?
  pagbankSubscriptionId String?
  billingRemindersSent  Json?

  applications    Application[]
  auditEvents     AuditEvent[]
  automationRules AutomationRule[]
  authSessions    AuthSession[]
  authVerificationCodes AuthVerificationCode[]
  calendarConnections CalendarConnection[]
  candidates      Candidate[]
  candidateNotes  CandidateNote[]
  emailMessages   EmailMessage[]
  emailTemplates  EmailTemplate[]
  embeddings      Embedding[]
  interviews      Interview[]
  jobs            Job[]
  memberships     Membership[]
  passwordResetTokens PasswordResetToken[]
  pipelineStages  PipelineStage[]
  resumes         ResumeDocument[]
  schedulingLinks SchedulingLink[]
  availabilitySettings UserAvailability[]
  skills          Skill[]
  candidateSkills CandidateSkill[]

  @@index([slug])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?
  preferredAuthFactor AuthFactorMethod @default(EMAIL_CODE)
  secondFactorEnabled Boolean   @default(false)
  imageUrl     String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditEvents         AuditEvent[]
  authSessions        AuthSession[]
  authVerificationCodes AuthVerificationCode[]
  calendarConnections CalendarConnection[]
  candidateNotes      CandidateNote[]
  createdJobs         Job[]           @relation("JobCreatedBy")
  memberships         Membership[]
  organizedInterviews Interview[]     @relation("InterviewOrganizer")
  organizedSchedulingLinks SchedulingLink[] @relation("SchedulingLinkOrganizer")
  availabilitySettings UserAvailability[] @relation("UserAvailabilityOwner")
  reviewedResumes     ResumeDocument[] @relation("ResumeReviewer")
  sentEmails          EmailMessage[]  @relation("EmailSender")
  managedJobs         Job[]           @relation("JobHiringManager")
  passwordResetTokens PasswordResetToken[]
}

model UserAvailability {
  id                     String   @id @default(cuid())
  organizationId         String
  userId                 String
  timezone               String   @default("America/Sao_Paulo")
  workingDays            Int[]    @default([1, 2, 3, 4, 5])
  workdayStartHour       Int      @default(9)
  workdayEndHour         Int      @default(17)
  slotIntervalMinutes    Int      @default(30)
  defaultDurationMinutes Int      @default(45)
  bufferBeforeMinutes    Int      @default(0)
  bufferAfterMinutes     Int      @default(15)
  maxDaysAhead           Int      @default(10)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("UserAvailabilityOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole   @default(RECRUITER)
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model AuthSession {
  id             String    @id
  userId         String
  organizationId String?
  tokenHash      String    @unique
  deviceLabel    String?
  userAgent      String?
  userAgentHash  String?
  ipHash         String?
  trusted        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([organizationId])
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String?
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
}

model AuthVerificationCode {
  id             String                  @id
  userId         String
  organizationId String
  method         AuthFactorMethod        @default(EMAIL_CODE)
  purpose        AuthVerificationPurpose
  codeHash       String
  sentTo         String
  expiresAt      DateTime
  consumedAt     DateTime?
  attempts       Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, purpose, expiresAt])
  @@index([organizationId, createdAt])
}

model Job {
  id               String         @id @default(cuid())
  organizationId   String
  createdById      String?
  hiringManagerId  String?
  title            String
  department       String?
  location         String?
  workMode         WorkMode       @default(REMOTE)
  employmentType   EmploymentType @default(FULL_TIME)
  status           JobStatus      @default(DRAFT)
  openings         Int            @default(1)
  currency         String         @default("USD")
  salaryMin        Int?
  salaryMax        Int?
  description      String
  requirements     Json?
  responsibilities Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  publishedAt      DateTime?
  closedAt         DateTime?

  applications   Application[]
  auditEvents    AuditEvent[]
  createdBy      User?           @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  embeddings     Embedding[]
  hiringManager  User?           @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  interviews     Interview[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineStages PipelineStage[]

  @@index([organizationId, status])
  @@index([hiringManagerId])
}

model Candidate {
  id                String          @id @default(cuid())
  organizationId    String
  name              String
  email             String?
  phone             String?
  location          String?
  source            CandidateSource @default(MANUAL)
  currentTitle      String?
  summary           String?
  yearsExperience   Int?
  availability      String?
  salaryExpectation Int?
  currency          String          @default("USD")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  applications  Application[]
  auditEvents   AuditEvent[]
  education     CandidateEducation[]
  embeddings    Embedding[]
  experience    CandidateExperience[]
  interviews    Interview[]
  notes         CandidateNote[]
  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resumes       ResumeDocument[]
  skills        CandidateSkill[]
  emailMessages EmailMessage[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
  @@index([organizationId, source])
}

model Skill {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  candidates   CandidateSkill[]
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CandidateSkill {
  id             String   @id @default(cuid())
  organizationId String
  candidateId    String
  skillId        String
  confidence     Int?
  createdAt      DateTime @default(now())

  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([organizationId])
}

model CandidateExperience {
  id          String    @id @default(cuid())
  candidateId String
  company     String
  title       String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateEducation {
  id          String    @id @default(cuid())
  candidateId String
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model ResumeDocument {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  fileName       String
  fileKey        String?
  fileUrl        String?
  mimeType       String?
  sizeBytes      Int?
  parserStatus   ParserStatus @default(UPLOADED)
  rawText        String?
  parsedData     Json?
  parsedAt       DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ResumeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, parserStatus])
  @@index([organizationId, reviewedAt])
  @@index([candidateId])
  @@index([reviewedById])
}

model PipelineStage {
  id             String           @id @default(cuid())
  organizationId String
  jobId          String
  name           String
  category       PipelineCategory
  position       Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  applications    Application[]
  automationRules AutomationRule[]
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([jobId, position])
  @@index([organizationId])
}

model Application {
  id               String            @id @default(cuid())
  publicToken      String?           @unique
  organizationId   String
  jobId            String
  candidateId      String
  stageId          String?
  status           ApplicationStatus @default(ACTIVE)
  source           CandidateSource   @default(MANUAL)
  matchScore       Int?
  matchExplanation Json?
  pipelinePosition Int               @default(0)
  aiAnalysisStatus AiAnalysisStatus  @default(NOT_ANALYZED)
  aiRecommendation String?
  aiFitLevel       String?
  aiMatchedRequirements Json?
  aiMissingRequirements Json?
  aiSkillsFound    Json?
  aiExperienceSummary String?
  aiRiskPoints     Json?
  aiSummary        String?
  aiAnalyzedAt     DateTime?
  appliedAt        DateTime          @default(now())
  stageEnteredAt   DateTime          @default(now())
  rejectedAt       DateTime?
  hiredAt          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  auditEvents   AuditEvent[]
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  emailMessages EmailMessage[]
  interviews    Interview[]
  schedulingLinks SchedulingLink[]
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notes         CandidateNote[]
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage         PipelineStage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([jobId, candidateId])
  @@index([organizationId, status])
  @@index([stageId])
}

model CandidateNote {
  id             String         @id @default(cuid())
  organizationId String
  candidateId    String
  applicationId  String?
  authorId       String?
  body           String
  visibility     NoteVisibility @default(TEAM)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  application  Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([candidateId])
}

model Interview {
  id              String          @id @default(cuid())
  organizationId  String
  applicationId   String
  candidateId     String
  jobId           String
  organizerId     String?
  title           String
  type            InterviewType   @default(PHONE_SCREEN)
  status          InterviewStatus @default(SCHEDULED)
  startsAt        DateTime
  endsAt          DateTime
  timezone        String          @default("America/Sao_Paulo")
  meetingUrl      String?
  calendarProvider String?
  calendarEventId String?
  calendarEventUrl String?
  calendarSyncStatus CalendarSyncStatus @default(NOT_SYNCED)
  calendarSyncedAt DateTime?
  calendarSyncError String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizer    User?        @relation("InterviewOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  schedulingLinks SchedulingLink[]

  @@index([organizationId, startsAt])
  @@index([candidateId])
}

model SchedulingLink {
  id                  String        @id @default(cuid())
  organizationId      String
  applicationId       String
  organizerId         String?
  interviewId         String?
  token               String        @unique
  title               String
  type                InterviewType @default(PHONE_SCREEN)
  durationMinutes     Int           @default(45)
  timezone            String        @default("America/Sao_Paulo")
  meetingUrl          String?
  maxDaysAhead        Int           @default(10)
  slotIntervalMinutes Int           @default(30)
  workingDays         Int[]         @default([1, 2, 3, 4, 5])
  workdayStartHour    Int           @default(9)
  workdayEndHour      Int           @default(17)
  bufferBeforeMinutes Int           @default(0)
  bufferAfterMinutes  Int           @default(15)
  active              Boolean       @default(true)
  expiresAt           DateTime?
  bookedAt            DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview    Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizer    User?        @relation("SchedulingLinkOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([organizationId, active])
  @@index([applicationId])
  @@index([organizerId])
  @@index([token])
}

model CalendarConnection {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  provider       String   @default("google")
  connectedEmail String?
  calendarId     String   @default("primary")
  accessToken    String
  refreshToken   String?
  scope          String?
  tokenType      String?
  expiresAt      DateTime?
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([organizationId])
  @@index([userId])
}

model EmailTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String
  trigger        EmailTrigger @default(MANUAL)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  automationRules AutomationRule[]
  messages        EmailMessage[]
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model EmailMessage {
  id                String       @id @default(cuid())
  organizationId    String
  candidateId       String?
  applicationId     String?
  templateId        String?
  senderId          String?
  toEmail           String
  subject           String
  body              String
  status            EmailStatus  @default(DRAFT)
  trigger           EmailTrigger @default(MANUAL)
  provider          String?
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  application  Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  candidate    Candidate?     @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       User?          @relation("EmailSender", fields: [senderId], references: [id], onDelete: SetNull)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([candidateId])
}

model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  trigger        AutomationTrigger
  stageId        String?
  templateId     String?
  active         Boolean           @default(true)
  delayMinutes   Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage        PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, active])
}

model Embedding {
  id             String          @id @default(cuid())
  organizationId String
  entityType     EmbeddingEntity
  candidateId    String?
  jobId          String?
  model          String
  dimensions     Int
  contentHash    String
  vector         Json?
  metadata       Json?
  createdAt      DateTime        @default(now())

  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType])
  @@index([candidateId])
  @@index([jobId])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  jobId          String?
  candidateId    String?
  applicationId  String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String    @default("pagbank")
  externalId     String
  eventType      String
  organizationId String?
  status         String    @default("received")
  payload        Json?
  error          String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([organizationId, createdAt])
  @@index([status])
}
