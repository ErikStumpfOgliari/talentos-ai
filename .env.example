DATABASE_URL="postgresql://aptelys:aptelys@localhost:5432/aptelys_ai?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional AI parsing
OPENAI_API_KEY=""
AI_PROVIDER_MODE="local"
OPENAI_RESUME_PARSER_MODEL="gpt-4.1-mini"

# Email delivery
# Leave RESEND_API_KEY empty to keep messages in local outbox mode.
RESEND_API_KEY=""
EMAIL_FROM="Aptelys <onboarding@resend.dev>"
RESEND_WEBHOOK_SECRET=""

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"
GOOGLE_CALENDAR_CREATE_MEET="true"
GOOGLE_CALENDAR_SEND_UPDATES="none"

# Resume storage
# Local development storage is written under storage/resumes.

# S3-compatible storage for production, including AWS S3, Cloudflare R2, MinIO, or Supabase S3.
# Supabase example:
# RESUME_STORAGE_S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
# RESUME_STORAGE_S3_REGION="<project-region>"
# RESUME_STORAGE_S3_BUCKET="resumes"
# RESUME_STORAGE_S3_FORCE_PATH_STYLE="true"
RESUME_STORAGE_S3_BUCKET=""
RESUME_STORAGE_S3_REGION="us-east-1"
RESUME_STORAGE_S3_ENDPOINT=""
RESUME_STORAGE_S3_ACCESS_KEY_ID=""
RESUME_STORAGE_S3_SECRET_ACCESS_KEY=""
RESUME_STORAGE_S3_FORCE_PATH_STYLE="false"
RESUME_STORAGE_PUBLIC_BASE_URL=""
